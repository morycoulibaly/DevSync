# PostgreSQL connection used by the root Prisma schema
DATABASE_URL="postgresql://tresor:change-me@localhost:5432/devsync?schema=public"

# API and web application
PORT=4000
FRONTEND_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000

# GitHub OAuth App callback: http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback

# Generate two independent 32-byte hex values with: openssl rand -hex 32
APP_SESSION_SECRET=replace-with-a-64-character-hex-value
APP_ENCRYPTION_KEY=replace-with-a-different-64-character-hex-value

# Redis (BullMQ, to be wired in a later step)
REDIS_HOST=localhost
REDIS_PORT=6379
